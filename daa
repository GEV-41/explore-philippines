        </nav>
    </div>
</header>

<section class="hero">

    <img src="images/home-hero.jpg" alt="Philippines">

    <div class="hero-overlay"></div>

    <div class="hero-text">
        <p class="eyebrow">DISCOVER THE PHILIPPINES</p>

        <h1>
            Find your next
            <span>adventure.</span>
        </h1>

        <p>
            Discover beautiful islands, mountains, heritage cities,
            delicious food and unforgettable experiences.
        </p>

        <div class="buttons">
            <a href="things-to-do.html" class="btn">Explore Now</a>
            <a href="#destinations" class="btn-outline">Destinations</a>
        </div>
    </div>
</section>

<section class="search-box">
    <div>
        <small>WHERE</small>
        <input id="searchInput" type="text" placeholder="Search a destination...">
    </div>

    <div>
        <small>EXPERIENCE</small>
        <select id="experienceSelect">
            <option>Any experience</option>
            <option>Beach</option>
            <option>Adventure</option>
            <option>Nature</option>
            <option>Culture</option>
            <option>Food</option>
        </select>
    </div>

    <button onclick="searchDestination()">Search</button>
</section>

<section class="section" id="destinations">

    <div class="section-title">
        <div>
            <p class="eyebrow">EXPLORE</p>
            <h2>Featured Destinations</h2>
        </div>

        <a href="things-to-do.html">View all →</a>
    </div>

    <div class="destination-grid">

        <article class="destination-card">
            <img src="images/bohol/bohol-hero.jpg" alt="Bohol">

            <div class="card-body">
                <small>📍 Central Visayas</small>
                <h3>Bohol</h3>
                <p>
                    Discover the Chocolate Hills, beautiful beaches,
                    wildlife and unforgettable island adventures.
                </p>
                <a href="bohol.html">Explore Bohol →</a>
            </div>
        </article>

        <article class="destination-card">
            <img src="images/mayon/mayon-hero.jpg" alt="Mayon Volcano">

            <div class="card-body">
                <small>📍 Bicol Region</small>
                <h3>Mayon Volcano</h3>
                <p>
                    Experience one of the Philippines' most
                    recognizable natural landmarks.
                </p>
                <a href="mayon.html">Explore Mayon →</a>
            </div>
        </article>

        <article class="destination-card">
            <img src="images/banaue/banaue-hero.jpg" alt="Banaue">

            <div class="card-body">
                <small>📍 Ifugao</small>
                <h3>Banaue</h3>
                <p>
                    Explore spectacular mountain landscapes and
                    centuries-old rice terraces.
                </p>
                <a href="banaue.html">Explore Banaue →</a>
            </div>
        </article>

        <article class="destination-card">
            <img src="images/palawan/palawan-hero.jpg" alt="Palawan">

            <div class="card-body">
                <small>📍 Palawan</small>
                <h3>Palawan</h3>
                <p>
                    Discover crystal-clear waters, islands,
                    lagoons and marine adventures.
                </p>
                <a href="palawan.html">Explore Palawan →</a>
            </div>
        </article>

        <article class="destination-card">
            <img src="images/siargao/siargao-hero.jpg" alt="Siargao">

            <div class="card-body">
                <small>📍 Surigao del Norte</small>
                <h3>Siargao</h3>
                <p>
                    Surf, island-hop and experience the tropical
                    atmosphere of Siargao.
                </p>
                <a href="siargao.html">Explore Siargao →</a>
            </div>
        </article>

        <article class="destination-card">
            <img src="images/vigan/vigan-hero.jpg" alt="Vigan">

            <div class="card-body">
                <small>📍 Ilocos Sur</small>
                <h3>Vigan</h3>
                <p>
                    Walk through historic streets and experience
                    Filipino heritage and culture.
                </p>
                <a href="vigan.html">Explore Vigan →</a>
            </div>
        </article>

    </div>
</section>

<section class="dark-section">

    <div class="section-title light">
        <div>
            <p class="eyebrow">CHOOSE YOUR EXPERIENCE</p>
            <h2>What do you want to do?</h2>
        </div>

        <a href="things-to-do.html">See everything →</a>
    </div>

    <div class="experience-grid">

        <a href="things-to-do.html" class="experience">
            <span>🌊</span>
            <h3>Beaches</h3>
            <p>Relax beside beautiful Philippine waters.</p>
        </a>

        <a href="things-to-do.html" class="experience">
            <span>🏔️</span>
            <h3>Adventure</h3>
            <p>Find mountains, trails and outdoor activities.</p>
        </a>

        <a href="things-to-do.html" class="experience">
            <span>🌿</span>
            <h3>Nature</h3>
            <p>Explore incredible natural landscapes.</p>
        </a>

        <a href="things-to-do.html" class="experience">
            <span>🏛️</span>
            <h3>Culture</h3>
            <p>Discover history and Filipino traditions.</p>
        </a>

    </div>
</section>

